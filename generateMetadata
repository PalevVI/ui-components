export type SchemaNode = Record<string, any>
export type OpenApiDocument = { components?: { schemas?: Record<string, SchemaNode> } }

const SPREAD_PLACEHOLDER = '__SPREAD__'
const REF_RE = /\{\s*"\$ref":\s*"#\/components\/schemas\/([^"]+)"\s*\}/g
const PROP_REF_RE = /"([^"]+)":\s*\{\s*"\$ref":\s*"#\/components\/schemas\/([^"]+)"\s*\}/g
const ARR_REF_RE = /"([^"]+)":\s*\[([^\]]*\{\s*"\$ref":\s*"#\/components\/schemas\/[^"]+"\s*\}[^\]]*)\]/g
const SPREAD_RE = new RegExp(`"(\\.\\.\\.\\w+(?:\\.properties)?)": "${SPREAD_PLACEHOLDER}"|"(\\.\\.\\.\\w+\\.required)"`, 'g')

export function generateMetadataFromOpenApi(openApi: OpenApiDocument): string {
  const schemas = openApi.components?.schemas ?? {}
  const flatCache = new Map<string, SchemaNode>()
  const declared = new Set<string>()
  const output: string[] = []

  const flatten = (node: any): any => {
    if (!node || typeof node !== 'object') return node
    if (Array.isArray(node)) return node.map(flatten)

    const { allOf, ...rest } = Object.fromEntries(Object.entries(node).map(([k, v]) => [k, flatten(v)]))
    if (!Array.isArray(allOf)) return rest
    if (allOf.length === 1 && allOf[0]?.$ref && !Object.keys(rest).length) return allOf[0]

    const items = [...allOf, rest]
    const mergeProps = items.filter((x) => x.$ref || x.properties).length > 1
    const mergeReq = items.filter((x) => x.$ref || x.required).length > 1
    const required: unknown[] = []
    const properties: SchemaNode = {}
    const merged: SchemaNode = {}

    for (const item of items) {
      const ref = item.$ref?.split('/').pop()
      if (ref) {
        merged[`...${ref}`] = SPREAD_PLACEHOLDER
        const target = dfs(ref)
        if (mergeReq && target?.required) required.push(`...${ref}.required`)
        if (mergeProps && target?.properties) properties[`...${ref}.properties`] = SPREAD_PLACEHOLDER
      } else {
        Object.assign(merged, item)
        if (item.required) required.push(...item.required)
        if (item.properties) Object.assign(properties, item.properties)
      }
    }

    delete merged.required
    delete merged.properties
    if (required.length) merged.required = required
    if (Object.keys(properties).length) merged.properties = properties
    return merged
  }

  const dfs = (name: string): SchemaNode | undefined => {
    if (flatCache.has(name) || !schemas[name]) return flatCache.get(name)
    flatCache.set(name, schemas[name]) // Защита от цикла при рекурсивном flatten

    const flat = flatten(schemas[name])
    flatCache.set(name, flat)

    const json = JSON.stringify(flat, null, 2)
    for (const [, dep] of json.matchAll(REF_RE)) dfs(dep!)

    const code = json
      .replace(SPREAD_RE, '$1$2')
      .replace(PROP_REF_RE, (_, k, t) =>
        declared.has(t) ? `"${k}": ${t}` : `get "${k}"(): any { return ${t} }`,
      )
      .replace(ARR_REF_RE, (_, k, body: string) => {
        const ready = [...body.matchAll(REF_RE)].every(([, t]) => declared.has(t!))
        const items = body.replace(REF_RE, '$1')
        return ready ? `"${k}": [${items}]` : `get "${k}"(): any { return [${items}] }`
      })

    declared.add(name)
    output.push(`export const ${name} = ${code} as const`)
    return flat
  }

  Object.keys(schemas).forEach(dfs)
  return `${output.join('\n\n')}\n`
}
